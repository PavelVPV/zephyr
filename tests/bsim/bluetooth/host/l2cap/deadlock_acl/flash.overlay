&flash0 {

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		test_partition: partition@8000 {
			label = "test";
			reg = <0x00008000 0x00010000>;
		};
	};
};
