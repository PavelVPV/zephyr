// /dts-v1/;

/delete-node/ &uart0;

/ {
	chosen {
		zephyr,bt-mon-uart = &uart0;
	};

	uart0: uart {
		status = "okay";
		compatible = "zephyr,native-posix-uart";
		/* Dummy current-speed entry to comply with serial
		 * DTS binding
		 */
		current-speed = <0>;
	};

/*
	uart0: uart {
		status = "okay";
		compatible = "zephyr,native-tty-uart";
		current-speed = <115200>;
		serial-port = "/dev/ttyUSB20";
	};
	*/
};
